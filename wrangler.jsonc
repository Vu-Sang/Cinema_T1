{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "viewing-party-t1",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Room"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
  // SESSION_SECRET is a secret: set it with `wrangler secret put SESSION_SECRET`.
  "vars": {
    "SUPABASE_URL": "https://diiaruvbsuafppkelgbo.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_KUu-d2EzRa3Qa2GMpTi6ng_L-4hY8e2"
  }
}